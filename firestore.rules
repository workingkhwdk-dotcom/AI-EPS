rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher(code) {
      return signedIn() &&
        get(/databases/$(database)/documents/sessions/$(code)).data.teacherUid == request.auth.uid;
    }
    function sessionOpen(code) {
      return get(/databases/$(database)/documents/sessions/$(code)).data.get('closed', false) != true;
    }
    // work 안의 한 칸(예: s1.findings, live)에서 바뀐 키 집합
    function workKeys(d, section, field) { return d.work.get(section, {}).get(field, {}); }
    function myGroup(code) {
      return get(/databases/$(database)/documents/sessions/$(code)/members/$(request.auth.uid)).data.groupId;
    }
    function isMember(code, gid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/sessions/$(code)/members/$(request.auth.uid)) &&
        myGroup(code) == gid;
    }

    // 서버 설정(교사 목록 등): 클라이언트는 읽기·쓰기 모두 불가. Firebase 콘솔(관리자 권한)에서만 수정한다.
    match /config/{doc} {
      allow read, write: if false;
    }
    // 교사용 계정 만들기: 승인된 이메일·비밀번호 계정, 가입 기록, 인증 문구 시도 횟수. 서버만 읽고 쓴다.
    match /teacherAccounts/{uid} { allow read, write: if false; }
    match /teacherSignups/{uid} { allow read, write: if false; }
    match /teacherAttempts/{id} { allow read, write: if false; }
    // 교사가 만든 주제와 조사 결과, 하루 생성 횟수: 서버(topics 함수)만 읽고 쓴다. 주제는 만든 교사만 서버를 거쳐 본다.
    match /teacherTopics/{id} {
      allow read, write: if false;
      match /parts/{part} { allow read, write: if false; }
    }
    match /topicUsage/{uid} { allow read, write: if false; }

    match /sessions/{code} {
      // 교사는 자기 수업 목록 조회(쿼리)도 가능해야 하므로 resource 기준으로 판정
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid ||
        exists(/databases/$(database)/documents/sessions/$(code)/members/$(request.auth.uid)));
      allow write: if false; // Cloud Functions(Admin SDK)만 생성·수정

      // 학생 비밀번호 해시와 수업별 자료는 서버(Cloud Functions)만 읽고 쓴다
      match /creds/{id} { allow read, write: if false; }
      match /attempts/{id} { allow read, write: if false; }
      match /private/{doc} { allow read, write: if false; }
      // 인물 배정(누가 어떤 인물인지)과 감독자 판정·원래 응답은 교사만 읽는다. 학생이 읽을 수 있는 문서에는 두지 않는다.
      match /assign/{id} { allow read: if isTeacher(code); allow write: if false; }
      match /assignGroup/{id} { allow read: if isTeacher(code); allow write: if false; }
      match /guardlog/{id} { allow read: if isTeacher(code); allow write: if false; }

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher(code));
        // 학생은 자기 접속 신호(현재 단계, 마지막 접속 시각)만 갱신할 수 있다. 인물 배정 등은 서버만 쓴다.
        allow update: if signedIn() && request.auth.uid == uid && sessionOpen(code) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'lastSeen']) &&
          request.resource.data.stage is int && request.resource.data.stage >= 1 && request.resource.data.stage <= 7 &&
          request.resource.data.lastSeen == request.time;
        allow create, delete: if false;

        // 1단계 인물과의 대화: 본인과 교사만 읽을 수 있다(다른 학생은 누가 누구와 대화하는지 모른다). 기록은 서버만.
        match /chat/{chatId} {
          allow read: if signedIn() && (request.auth.uid == uid || isTeacher(code));
          allow write: if false;
        }
      }

      // 대화 규칙 위반 신호: 교사만 읽는다. 기록은 서버만
      match /alerts/{alertId} {
        allow read: if isTeacher(code);
        allow write: if false;
      }

      match /groups/{gid} {
        allow read: if isTeacher(code) || isMember(code, gid);
        // 학생은 모둠 산출물(work)만 수정할 수 있다
        // 모둠 공용 칸은 모둠원 누구나 고칠 수 있지만, 1단계 개인 정리(s1.findings)와 '입력 중' 표시(live)는 자기 칸만 고칠 수 있다.
        allow update: if isMember(code, gid) && sessionOpen(code) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['work']) &&
          workKeys(request.resource.data, 's1', 'findings').diff(workKeys(resource.data, 's1', 'findings')).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.work.get('live', {}).diff(resource.data.work.get('live', {})).affectedKeys().hasOnly([request.auth.uid]);
        allow create, delete: if false;

        // AI 상호작용 로그: 읽기만 허용, 기록은 서버만
        match /logs/{logId} {
          allow read: if isTeacher(code) || isMember(code, gid);
          allow write: if false;
        }
      }
    }
  }
}
