# 이 파일을 functions/.env 로 복사해 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 배포(firebase deploy) 때 "Enter a string value for ..." 질문이 뜨면, 그 이름의 줄이 .env 에 없다는 뜻입니다.
# 모든 줄을 채워 두면 질문 없이 배포됩니다. (질문에 답하면 functions/.env.<프로젝트ID> 에 저장됩니다)

# 교사 로그인을 허용할 구글 계정 (쉼표로 여러 명 가능).
# 관리자(working.khwdk@gmail.com)는 코드에 고정되어 있어 여기에 없어도 항상 교사입니다.
# 교사 추가·삭제는 Firebase 콘솔의 Firestore(config/teachers 문서의 emails 필드)에서 재배포 없이 할 수 있습니다.
TEACHER_EMAILS=

# 교사용 계정 만들기의 '교사 인증 문구'. 교사 화면에서 이 문구를 넣으면 누구나 교사 계정을 직접 만들 수 있습니다.
# 연수·안내 때 선생님들께만 알려 주세요. 비워 두면 교사 가입이 꺼집니다(대소문자·앞뒤 빈칸은 무시).
# 이메일·비밀번호 가입을 쓰려면 Firebase 콘솔 → Authentication → 로그인 방법에서 '이메일/비밀번호'를 켜 두세요.
TEACHER_SIGNUP_CODE=

# ---------- AI 모델 (2026-10 기준 추천: 비용과 성능의 균형) ----------
# gpt-5·gpt-5-mini 는 2026-12-11 에 API 에서 종료됩니다. 아래는 GPT-5.6 계열(sol 최상위 / terra 균형 / luna 저가)로 바꾼 조합입니다.
# 정확한 모델명과 가격은 OpenAI 대시보드의 Models·Pricing 에서 확인하세요. 바꾼 뒤에는 교사 화면 '인물·자료 점검' 탭의
# '연결·AI 점검'을 눌러 모든 모델·웹 검색·인물의 사실 찾아보기가 되는지 확인하세요.

# 기본 모델: 2단계 생각 도우미, 3단계 사실 확인, 4단계 검토, 웹 검색 요약, 체험 페이지(따로 정하지 않은 곳)에 쓰입니다.
# 양이 많고 수업 자료 안에서 짧게 답하는 일이라 저가 모델로 충분합니다.
OPENAI_MODEL=gpt-5.6-luna

# 1단계 인물 대화 전용 모델. 학생이 가장 많이 쓰는 핵심 경험이라 균형 모델을 씁니다.
# 시범 수업에서 대화가 밋밋하면 gpt-5.6-sol 로 올리세요(비용 약 2.5배).
PERSONA_MODEL=gpt-5.6-terra

# 5단계 시뮬레이션 전용 모델. 인과를 추론해야 해서 저가 모델은 부족합니다(모둠당 몇 번뿐이라 비용 영향은 작음).
SCENARIO_MODEL=gpt-5.6-terra

# 상위 AI(규범 감독자) 전용 모델. 학생에게 가는 모든 인물 응답을 검사하는 안전장치라 저가 모델로 낮추지 않는 것을 권합니다.
# (비용을 더 줄이려면 gpt-5.6-luna. 그때는 교사 화면의 '감독 개입' 기록을 보고 판단하세요.)
GUARD_MODEL=gpt-5.6-terra

# (선택) 4단계 독립 검토 3개에 쓸 모델들(쉼표로 구분). 비워 두면 OPENAI_MODEL 로 관점만 다르게 3번 검토합니다.
FEEDBACK_MODELS=

# 체험(demo) 페이지 모델. 비우면 OPENAI_MODEL. 로그인 없이 누구나 쓰는 곳이라 저가 모델을 씁니다.
DEMO_MODEL=gpt-5.6-luna

# 교사 '내 주제' 만들기. 가끔 쓰고 여러 수업에 오래 쓰이므로 최상위 모델을 씁니다(주제 하나에 대략 5~10달러).
TOPIC_MODEL=gpt-5.6-sol
# 주제 조사(웹 검색). 검색 결과 문장에 인용 링크가 정확히 붙어야 해서 저가 모델은 피합니다.
TOPIC_SEARCH_MODEL=gpt-5.6-terra

# 1단계 인물이 자기 자료에 없는 사실을 질문받으면 웹에서 찾아 보고 답한다(못 찾으면 모른다고 답함). false 로 끄기.
PERSONA_WEB_SEARCH=true
# 웹 검색 호출에 쓸 모델(OpenAI web_search 도구 지원 모델: 인물의 사실 찾아보기, 3단계 검색). 비우면 OPENAI_MODEL(luna)을 씁니다.
SEARCH_MODEL=

# (선택) 인물의 웹 검색을 허용할 도메인(쉼표). 비우면 제한 없음. 믿을 만한 출처만 쓰게 하려면 채우세요.
# 너무 좁으면 '못 찾음'이 늘어납니다. 예: SEARCH_ALLOWED_DOMAINS=yna.co.kr,hani.co.kr,khan.co.kr,chosun.com,joongang.co.kr,kbs.co.kr,mbc.co.kr,sbs.co.kr,moj.go.kr,humanrights.go.kr,unhcr.org
SEARCH_ALLOWED_DOMAINS=

# 추론 모델의 사고량(minimal | low | medium | high). 대화 응답 속도를 위해 low 를 권장합니다.
# minimal 을 받지 않는 새 모델(gpt-5.1 이후)에는 코드가 알아서 none 으로 바꿔 보냅니다.
# 5단계 시뮬레이션은 코드에서 medium 으로 고정되어 있습니다.
REASONING_EFFORT=low

# (예전 설정 ALLOW_UNVERIFIED_PERSONAS 는 없앴습니다. 학생에게는 항상 원문 확인을 마친 인물·자료만 보입니다.
#  수업 전에 미리 해 보려면 체험 페이지(/demo.html)를 쓰세요. 이 줄이 .env 에 남아 있어도 읽지 않습니다.)

# 입장·수업 시작 호출을 항상 켜 둘 인스턴스 수. 0 이면 쓰지 않을 때 꺼져서 첫 입장이 몇 초 느릴 수 있습니다.
# 수업 시간에만 1 로 올리고 배포하면 첫 학생부터 빠르게 들어옵니다(상시 켜 두는 비용이 조금 듭니다).
MIN_INSTANCES=0
