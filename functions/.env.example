# 이 파일을 functions/.env 로 복사해 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 배포(firebase deploy) 때 "Enter a string value for ..." 질문이 뜨면, 그 이름의 줄이 .env 에 없다는 뜻입니다.
# 모든 줄을 채워 두면 질문 없이 배포됩니다. (질문에 답하면 functions/.env.<프로젝트ID> 에 저장됩니다)

# 교사 로그인을 허용할 구글 계정 (쉼표로 여러 명 가능)
TEACHER_EMAILS=교사구글계정@gmail.com

# 기본 모델: 인물 대화, 3단계 검색 보조, 4단계 피드백에 쓰입니다. GPT-5 계열의 균형 모델을 권장합니다.
# 사용 가능한 정확한 모델명은 OpenAI 대시보드의 Models 페이지에서 확인하세요.
OPENAI_MODEL=gpt-5-mini

# 5단계 시뮬레이션 전용 모델. 더 강한 모델을 권장합니다. 대화와 같은 모델로 쓰려면 OPENAI_MODEL 과 같은 값을 적으세요.
SCENARIO_MODEL=gpt-5

# 상위 AI(규범 감독자) 전용 모델. 인물 AI와 다른 모델이 검사하면 서로의 약점을 보완합니다.
# 비용을 줄이려면 OPENAI_MODEL 과 같은 값을 적으세요.
GUARD_MODEL=gpt-5

# 추론 모델의 사고량(minimal | low | medium | high). 대화 응답 속도를 위해 low 를 권장합니다.
# 5단계 시뮬레이션은 코드에서 medium 으로 고정되어 있습니다.
REASONING_EFFORT=low

# 리허설 전용: true 이면 원문 대조 전(verified:false) 인물도 학생에게 보인다.
# 실제 수업에서는 반드시 false 로 두거나 이 줄을 지운다.
ALLOW_UNVERIFIED_PERSONAS=true
